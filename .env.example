# API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
PAGEINDEX_API_KEY=

# Auth
JWT_SECRET=change-me-in-prod

# Tracing
LANGCHAIN_TRACING_V2=true

# Service URLs (defaults work with docker-compose)
GPTCACHE_URL=http://gptcache:8000
RIVAL_URL=http://rival-service:8002
MONGODB_URI=mongodb://mongodb:27017
POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/support_bot

# Tuning
MAX_INPUT_CHARS=4000
MAX_SESSION_TURNS=10
FAITHFULNESS_THRESHOLD=0.7
COMPLETENESS_THRESHOLD=0.6
LOW_COMPLEXITY_MODEL=gemini-3.5-flash
HIGH_COMPLEXITY_MODEL=gemini-3.1-pro

# Eval config (used by CI/CD)
EVAL_APP_URL=http://localhost:8000
EVAL_JWT_SECRET=change-me-in-prod
